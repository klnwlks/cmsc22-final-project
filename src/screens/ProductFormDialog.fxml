<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Orientation?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<DialogPane xmlns:fx="http://javafx.com/fxml/1" stylesheets="@CommonStyle.css, @ProductFormDialogStyle.css" prefWidth="340">
    <buttonTypes>
        <ButtonType fx:constant="OK" />
        <ButtonType fx:constant="CANCEL" />
    </buttonTypes>
    <content>
        <GridPane vgap="15">
            <VBox spacing="2" GridPane.rowIndex="1">
           		<Label text="Product name" GridPane.rowIndex="0" styleClass="category"/>
            	<TextField fx:id="name" styleClass="input-field"/>
            </VBox>
            <VBox spacing="2" GridPane.rowIndex="2">
            	<Label text="Size / Description" GridPane.rowIndex="3" styleClass="category"/>
            	<TextField fx:id="description" styleClass="input-field"/>
            </VBox>
            <VBox spacing="2" GridPane.rowIndex="3">
            	<Label text="Category" GridPane.rowIndex="6" styleClass="category"/>
            	<ComboBox fx:id="category" styleClass="category-combobox"/>
            </VBox>
            <VBox spacing="2" GridPane.rowIndex="4">
            	<Label text="Price (whole pesos)" GridPane.rowIndex="9" styleClass="category"/>
            	<TextField fx:id="price" text="0" styleClass="input-field"/>
            </VBox>
            <VBox spacing="2" GridPane.rowIndex="5">
            	<Label text="Stock quantity" GridPane.rowIndex="12" styleClass="category"/>
            	<TextField fx:id="stock" text="0" styleClass="input-field"/>
            </VBox>
            <VBox spacing="2" GridPane.rowIndex="6">
                <Label text="Product image (optional)" styleClass="category"/>
                <TextField fx:id="imagePath" editable="false" promptText="No image selected" styleClass="input-field"/>
                <Button text="Choose image..." onAction="#chooseImage"/>
            </VBox>
            <Label fx:id="error" GridPane.rowIndex="14" GridPane.columnSpan="2" styleClass="category"/>
        </GridPane>
    </content>
</DialogPane>
