<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<DialogPane xmlns:fx="http://javafx.com/fxml/1" stylesheets="@CommonStyle.css, @ProductFormDialogStyle.css" prefWidth="340" prefHeight="509.05">
    <buttonTypes>
        <ButtonType fx:constant="OK" />
        <ButtonType fx:constant="CANCEL" />
    </buttonTypes>
    <content>
        <GridPane hgap="10" vgap="10">
            <Label text="Product name" GridPane.rowIndex="0" />
            <HBox styleClass="input-field" GridPane.rowIndex="1">
            	<TextField fx:id="name" />
            </HBox>
            <Label text="Size / Description" GridPane.rowIndex="3" />
            <HBox styleClass="input-field" GridPane.rowIndex="4">
            	<TextField fx:id="description" />
            </HBox>
            <Label text="Category" GridPane.rowIndex="6" />
            <HBox styleClass="input-field" GridPane.rowIndex="7">
            	<ComboBox fx:id="category" />
            </HBox>
            <Label text="Price (whole pesos)" GridPane.rowIndex="9" />
            <HBox styleClass="input-field" GridPane.rowIndex="10">
            	<TextField fx:id="price" text="0" />
            </HBox>
            <Label text="Stock quantity" GridPane.rowIndex="12" />
            <HBox styleClass="input-field" GridPane.rowIndex="13">
            	<TextField fx:id="stock" text="0" />
            </HBox>
            <Label fx:id="error" GridPane.rowIndex="14" GridPane.columnSpan="2" />
        </GridPane>
    </content>
</DialogPane>
