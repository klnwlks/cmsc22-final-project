<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      alignment="CENTER" spacing="12" prefWidth="380" prefHeight="420"
      styleClass="main-screen">
    <padding><Insets top="32" right="36" bottom="32" left="36"/></padding>
    <Label fx:id="titleLabel" text="Cowlendar" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
    <Label fx:id="subtitleLabel" text="Create a clerk or manager account"/>
    <TextField fx:id="usernameField" promptText="Username" maxWidth="280"/>
    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="280"/>
    <ComboBox fx:id="roleField" promptText="Choose a role" maxWidth="280"/>
    <Label fx:id="errorLabel" wrapText="true" maxWidth="280" style="-fx-text-fill: #b00020;"/>
    <Button fx:id="submitButton" text="Create account" onAction="#handleSubmit"
            maxWidth="280" defaultButton="true" style="-fx-cursor: hand;"/>
    <Button fx:id="switchModeButton" text="Already have an account? Log in"
            onAction="#switchMode" maxWidth="280" style="-fx-cursor: hand;"/>
</VBox>
