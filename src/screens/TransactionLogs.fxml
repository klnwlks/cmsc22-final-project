<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" stylesheets="@CommonStyle.css, @TransactionLogsStyle.css">
    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
    </left>
    <center>
        <VBox spacing="18" styleClass="transactions-screen">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="5">
                    <Label text="Cowlendar / Transactions" styleClass="breadcrumb" />
                    <Label text="Transactions" styleClass="page-title" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="monthFilter" prefWidth="170" styleClass="month-filter" />
            </HBox>

            <HBox alignment="CENTER" spacing="12" styleClass="summary-cards">
                <VBox spacing="7" prefWidth="210" styleClass="sales-card">
                    <Label text="Total sales" styleClass="card-caption" />
                    <Label fx:id="totalSales" text="₱0.00" styleClass="card-total" />
                    <Label fx:id="salesSubtitle" text="For this month" styleClass="card-footnote" />
                </VBox>
                <VBox spacing="7" prefWidth="210" styleClass="count-card">
                    <Label text="Total transactions" styleClass="count-caption" />
                    <Label fx:id="totalTransactions" text="0" styleClass="count-total" />
                    <Label fx:id="transactionsSubtitle" text="For this month" styleClass="count-footnote" />
                </VBox>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-row">
                <TextField fx:id="searchField" promptText="Search transactions" prefWidth="190" styleClass="search-field" />
                <Label text="Filter by month using the date selector" styleClass="filter-hint" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="voidButton" text="Void sale" onAction="#voidSale" />
            </HBox>

            <VBox spacing="0" VBox.vgrow="ALWAYS" styleClass="table-card">
                <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS" styleClass="transactions-table">
                    <columns>
                        <TableColumn fx:id="dateColumn" text="Date and time" prefWidth="190" />
                        <TableColumn fx:id="userColumn" text="Sold by" prefWidth="150" />
                        <TableColumn fx:id="productColumn" text="Product" prefWidth="220" />
                        <TableColumn fx:id="quantityColumn" text="Items" prefWidth="100" />
                        <TableColumn fx:id="amountColumn" text="Total amount" prefWidth="150" />
                    </columns>
                    <placeholder><Label text="No transactions found." styleClass="empty-message" /></placeholder>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="pagination-bar">
                    <Label fx:id="transactionSummary" styleClass="pagination-summary" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="previousPageButton" text="Previous" onAction="#previousPage" styleClass="page-button" />
                    <Label fx:id="pageLabel" text="1 / 1" styleClass="page-number" />
                    <Button fx:id="nextPageButton" text="Next >" onAction="#nextPage" styleClass="page-button" />
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
