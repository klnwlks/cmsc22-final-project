<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" stylesheets="@CommonStyle.css, @ProductInventoryStyle.css">
    <left>
        <VBox spacing="12" prefWidth="180" styleClass="side-bar">
            <Label text="Cowlendar" />
            <Label text="DTRI Farm Fresh" />
            <Separator />
            <Button text="Gantt calendar" disable="true" maxWidth="Infinity" styleClass="side-bar-btn" />
            <Button text="Products &amp; Inventory" maxWidth="Infinity" styleClass="side-bar-pressed-btn" />
            <Button text="Transaction logs" onAction="#showTransactions" maxWidth="Infinity" styleClass="side-bar-btn" />
            <Region VBox.vgrow="ALWAYS" />
            <Label fx:id="userLabel" />
            <Button text="Log out" disable="true" />
        </VBox>
    </left>
    <center>
        <VBox spacing="16" styleClass="main-screen">
        	<VBox>
	            <Label text="Cowlendar / Products" />
	            <HBox spacing="12" alignment="CENTER_LEFT">
	                <Label text="Product and Inventory Management" />
	                <Region HBox.hgrow="ALWAYS" />
	                <Button fx:id="editProductButton" text="Edit product" onAction="#editProduct" />
	                <Button fx:id="addProductButton" text="Add product" onAction="#addProduct" />
	            </HBox>
            </VBox>
            <HBox spacing="32" styleClass="main-screen">
                <VBox spacing="6" styleClass="card-type-1"><Label text="Total products" styleClass="card-type-1-text, bold" /><Label fx:id="totalProducts" text="0"  styleClass="card-type-1-number, bold"/><Label fx:id="categorySummary" text="Across 0 categories" styleClass="card-type-1-text" /></VBox>
                <VBox spacing="6" styleClass="card-type-2"><Label text="Products in Stock" styleClass="card-type-2-text, bold" /><Label fx:id="productsInStock" text="0" styleClass="card-type-2-number, bold" /><Label text="Available for sale" styleClass="card-type-2-text" /></VBox>
                <VBox spacing="6" styleClass="card-type-2"><Label text="Current Product in Stock" styleClass="card-type-2-text, bold" /><Label fx:id="currentInStock" text="0" styleClass="card-type-2-number, bold" /><Label fx:id="currentSummary" text="All categories" styleClass="card-type-2-text" /></VBox>
            </HBox>
            <FlowPane hgap="6" vgap="6" styleClass="main-screen">
                <TextField fx:id="searchField" promptText="Search products" />
                <HBox fx:id="categoryFilters" spacing="6" />
            </FlowPane>
            <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="productColumn" text="Product" prefWidth="190" />
                    <TableColumn fx:id="categoryColumn" text="Category" prefWidth="100" />
                    <TableColumn fx:id="sizeColumn" text="Size / Description" prefWidth="130" />
                    <TableColumn fx:id="priceColumn" text="Price" prefWidth="80" />
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="110" />
                    <TableColumn fx:id="deleteColumn" text="" prefWidth="80" />
                </columns>
                <placeholder><Label text="No products found. Add a product to get started." /></placeholder>
            </TableView>
            <Label fx:id="resultSummary" text="Showing 0 products" />
        </VBox>
    </center>
</BorderPane>
